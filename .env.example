# Copy to .env locally. In Vercel, add each variable under Project Settings > Environment Variables.
# Use generated, private values. Never commit your real .env file.
SECRET_KEY=replace-with-a-long-random-secret
CRON_SECRET=replace-with-another-long-random-secret
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=kimathi_furniture
FRONTEND_URL=https://YOUR-DEPLOYMENT.vercel.app
PUBLIC_APP_URL=https://YOUR-DEPLOYMENT.vercel.app

# Daraja credentials from your Safaricom Daraja app; do not commit real values.
MPESA_ENV=sandbox
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=YOUR_DARAJA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_DARAJA_CONSUMER_SECRET
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
MPESA_BUSINESS_SHORT_CODE=YOUR_APPROVED_SHORTCODE
MPESA_VENDOR_TILL=YOUR_APPROVED_TILL_NUMBER
MPESA_PASSKEY=YOUR_DARAJA_PASSKEY
MPESA_CALLBACK_URL=https://YOUR-PRODUCTION-DOMAIN/api/mpesa/callback

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM=KIMATHI Furniture <orders@example.com>
SMTP_USE_TLS=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=SET-A-LONG-UNIQUE-PASSWORD
# Private admin URL path. Use a long random path such as /staff-<random-token>; do not share it publicly.
ADMIN_PATH=/private-office-console-change-this-path
ADMIN_PHONE=0702781490
DEFAULT_LOCATION=Kimathi, Nyeri
COMPANY_NAME=KIMATHI Furniture
PURCHASE_EMAIL_OTP_ENABLED=false
